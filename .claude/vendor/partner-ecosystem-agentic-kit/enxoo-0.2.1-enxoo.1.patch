+    def record(self, *extra, check=True):
+        with tempfile.TemporaryDirectory() as tmp:
+            output = Path(tmp) / "capabilities.json"
+            completed = subprocess.run(
+                [
+                    sys.executable,
+                    str(RECORD),
+                    "--output",
+                    str(output),
+                    "--harness",
+                    "claude-code",
+                    "--mcp-install",
+                    "deferred",
+                    "--policy-version",
+                    self.policy["policy_version"],
+                    *extra,
+                ],
+                check=check,
+                capture_output=True,
+                text=True,
+            )
+            value = json.loads(output.read_text(encoding="utf-8")) if output.exists() else None
+            return completed, value
+
+    def test_preference_recorder_writes_the_exact_customer_scope(self):
+        _, value = self.record(
+            "--documentation-domains",
+            "approved",
+            "--approved-host",
+            "Developer.Salesforce.com",
+            "--approved-host",
+            "lightningdesignsystem.com",
+            "--approved-url-prefix",
+            "https://github.com/forcedotcom/partner-ecosystem-agentic-kit/",
+        )
+        scope = value["approved_documentation_scope"]
+        self.assertEqual("explicit", scope["source"])
+        self.assertEqual(["developer.salesforce.com", "lightningdesignsystem.com"], scope["exact_hosts"])
+        self.assertEqual(
+            ["https://github.com/forcedotcom/partner-ecosystem-agentic-kit/"],
