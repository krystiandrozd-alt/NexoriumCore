# Nexorium Core - local demo settings (see DEMO.md).
# `npm run demo:setup` copies this file to .env and fills in CREDENTIAL_ENCRYPTION_KEY.

# Database: the PostgreSQL container from docker-compose.yml.
# For Supabase, replace both with your project's connection strings (keep ?schema=nexorium_core).
DATABASE_URL="postgresql://nexorium:nexorium@localhost:5432/nexorium?schema=nexorium_core"
DIRECT_URL="postgresql://nexorium:nexorium@localhost:5432/nexorium?schema=nexorium_core"

# Sign-in. With NEXORIUM_DEMO_MODE=true the app opens without signing in and the two
# Supabase values below are not used. For real sign-in, set your Supabase project URL
# and anon key and change NEXORIUM_DEMO_MODE to false.
NEXORIUM_DEMO_MODE=true
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Encrypts connector credentials (AES-256). Filled in by `npm run demo:setup`.
CREDENTIAL_ENCRYPTION_KEY=""
