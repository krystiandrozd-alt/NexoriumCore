# TelEnvIQ Environment Configuration
# Copy this file to .env and fill in the values

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/telenviq?schema=public"

# Node environment
NODE_ENV="development"

# Credential encryption key (32 bytes / 64 hex characters for AES-256)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=""

# Optional: External Integrations (for future use)
# KUBERNETES_API_URL=""
# KUBERNETES_TOKEN=""
# GITOPS_REPO_TOKEN=""
