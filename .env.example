# Nexorium Core Environment Configuration
# Copy this file to .env and fill in the values

# Neon Auth (authentication) - see README, section "Authentication"
# Auth URL of the Neon branch/database: Neon Console -> project -> Settings -> Auth
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth"
# Secret for the app's session cookie, at least 32 characters. Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=""

# Database (PostgreSQL on Neon, Prisma ORM) - see README, section "Database"
# Take user, password and host from the Neon Console (project -> branch -> Connect, database neondb)
# and keep the ?schema=nexorium_core suffix: the application tables live in that schema.
# Pooled connection for the running app (host contains "-pooler")
DATABASE_URL="postgresql://<user>:<password>@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require&connect_timeout=15&schema=nexorium_core"
# Direct (unpooled) connection for the Prisma CLI (migrations, seed): same host without "-pooler"
DIRECT_URL="postgresql://<user>:<password>@ep-xxx.<region>.aws.neon.tech/neondb?sslmode=require&schema=nexorium_core"

# Node environment
NODE_ENV="development"

# Credential encryption key (32 bytes / 64 hex characters for AES-256)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=""

# Optional: External Integrations (for future use)
# KUBERNETES_API_URL=""
# KUBERNETES_TOKEN=""
# GITOPS_REPO_TOKEN=""

# ============================================
# TEST CONFIGURATION (for E2E tests only)
# ============================================
# Set these in your local environment or CI secrets
# DO NOT commit actual credentials!
# TEST_EMAIL="test@example.com"
# TEST_PASSWORD="your-test-password"
