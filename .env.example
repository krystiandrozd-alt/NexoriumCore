# Nexorium Core Environment Configuration
# Copy this file to .env and fill in the values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Database Configuration (PostgreSQL via Supabase)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres?schema=nexorium_core"

# Node environment
NODE_ENV="development"

# Credential encryption key (32 bytes / 64 hex characters for AES-256)
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=""

# Optional: External Integrations (for future use)
# KUBERNETES_API_URL=""
# KUBERNETES_TOKEN=""
# GITOPS_REPO_TOKEN=""

# ============================================
# TEST CONFIGURATION (for E2E tests only)
# ============================================
# Set these in your local environment or CI secrets
# DO NOT commit actual credentials!
# TEST_EMAIL="test@example.com"
# TEST_PASSWORD="your-test-password"
